# 8. PIPELINE
# ==========================================================
def save_tensor(t, path):
    """t: [3,H,W] tensor in [-1,1]. Saves as JPEG."""
    img = (t.clamp(-1, 1) + 1) / 2          # → [0,1]
    arr = (img.mul(255).add_(0.5).clamp_(0, 255)
              .permute(1, 2, 0).to("cpu", torch.uint8).numpy())
    Image.fromarray(arr).save(str(path), format="JPEG", quality=95)
def split_class(indices, cfg):
    """8 : 1 : 1 per class, stratified."""
    tr, tmp = train_test_split(indices, test_size=(1-cfg.train_ratio), random_state=42)
    va, te  = train_test_split(tmp, test_size=0.5, random_state=42)
    return tr, va, te

def run_pipeline():
    cfg = QAGSConfig()
    print("🔍 Loading dataset…")
    ds = ImprovedMedicalDataset(cfg.root_dir, cfg)
    if len(ds) == 0:
        print("❌ Dataset empty / path wrong."); return
    print(f"   Loaded {len(ds)} images across {len(ds.class_to_idx)} raw classes.")

    # --- Filter + 8:1:1 split ---
    valid = {}
    for name, cid in ds.class_to_idx.items():
        idx = ds.class_indices.get(cid, [])
        if len(idx) < cfg.min_samples_threshold:
            print(f"   ⚠️ Skip {name} ({len(idx)} < {cfg.min_samples_threshold})")
            continue
        tr, va, te = split_class(idx, cfg)
        valid[name] = {"id": cid, "train": tr, "val": va, "test": te}
        print(f"   ✅ {name}: train={len(tr)} val={len(va)} test={len(te)}")
    if not valid:
        print("❌ No classes pass the threshold."); return

    # --- Prepare output dirs ---
    for d in (cfg.train_dir, cfg.val_dir, cfg.test_dir):
        if d.exists(): shutil.rmtree(d)
        d.mkdir(parents=True, exist_ok=True)

    # --- Train VAE on train-only real images ---
    train_idx_all = [i for c in valid.values() for i in c["train"]]
    vae = SimpleVAE(len(ds.class_to_idx), cfg.latent_dim)
    vae = VAETrainer(cfg).train(vae, SubsetDataset(ds, train_idx_all))

    # --- Reconstruction metrics on real VAL (never seen by VAE) ---
    val_idx_all = [i for c in valid.values() for i in c["val"]]
    val_loader  = DataLoader(SubsetDataset(ds, val_idx_all), batch_size=cfg.batch_size,
                             shuffle=False, collate_fn=collate_fn, num_workers=cfg.num_workers)
    metrics_eng = MetricsEngine(cfg.device)
    attn = GPUAttentionGenerator(cfg.device)
    recon_m = metrics_eng.reconstruction_metrics(vae, val_loader, attn, n_batches=20)

    # --- Build splits (synthetic ONLY on train) ---
    smote = MedicalSMOTE(vae, cfg)
    all_real_train, all_syn_train = [], []
    MAX_FID = 1000
    report = {"per_class": {}, "global_metrics": recon_m}

    for name, c in valid.items():
        # TRAIN: copy real, then augment to 900
        tr_dir = cfg.train_dir / name; tr_dir.mkdir(parents=True, exist_ok=True)
        n_real = 0
        for i in c["train"]:
            shutil.copy(ds.samples[i][0], tr_dir / f"real_{n_real:04d}.jpg")
            n_real += 1
            all_real_train.append(ds[i]["image"])

        n_syn = 0
        if n_real < cfg.train_target_per_class:
            needed = cfg.train_target_per_class - n_real
            subset = [ds[i] for i in c["train"]]
            mus, labs = smote.encode_samples(subset)
            latents   = smote.generate_latents(mus, labs, needed)
            syn_imgs  = smote.decode_latents(latents)
            for k, t in enumerate(syn_imgs):
                save_tensor(t, tr_dir / f"syn_{k:04d}.jpg")
                all_syn_train.append(t)
            n_syn = len(syn_imgs)

        # VAL: copy real only
        va_dir = cfg.val_dir / name; va_dir.mkdir(parents=True, exist_ok=True)
        for j, i in enumerate(c["val"]):
            shutil.copy(ds.samples[i][0], va_dir / f"real_{j:04d}.jpg")

        # TEST: copy real only
        te_dir = cfg.test_dir / name; te_dir.mkdir(parents=True, exist_ok=True)
        for j, i in enumerate(c["test"]):
            shutil.copy(ds.samples[i][0], te_dir / f"real_{j:04d}.jpg")

        report["per_class"][name] = {"train_real": n_real, "train_syn": n_syn,
                                     "val": len(c["val"]), "test": len(c["test"])}
        print(f"   📁 {name}: train {n_real}+{n_syn}={n_real+n_syn} | val {len(c['val'])} | test {len(c['test'])}")

    # --- Global FID: real-train vs synthetic-train ---
    if all_syn_train:
        real_t = torch.stack(all_real_train[:MAX_FID])   # CPU
        syn_t  = torch.stack(all_syn_train [:MAX_FID])   # CPU
        report["global_metrics"]["FID"] = metrics_eng.fid_score(real_t, syn_t, batch_size=64)
        del real_t, syn_t

    # free the accumulators so they don't linger
    del all_real_train, all_syn_train
    torch.cuda.empty_cache()

    # --- Write metrics + manifest ---
    with open(cfg.output_base / "metrics.json", "w") as f:
        json.dump(report, f, indent=2)
    print("\n📊 Metrics:", json.dumps(report["global_metrics"], indent=2))

    # --- ZIP ---
    zip_name = "GastroVision_900_8_1_1"
    shutil.make_archive(zip_name, "zip", cfg.output_base)
    print(f"\n🎉 Done. ZIP: {zip_name}.zip  |  metrics: {cfg.output_base}/metrics.json")

if __name__ == "__main__":
    run_pipeline()
