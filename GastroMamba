# 11. TRAINING LOOP (with history)
# ==============================================================
def get_warmup_cosine_scheduler(optimizer, warmup_epochs=5, T_0=10, T_mult=2, eta_min=1e-6, last_epoch=-1):
    class WarmupCosineScheduler:
        def __init__(self, optimizer, warmup_epochs, T_0, T_mult, eta_min):
            self.optimizer = optimizer
            self.warmup_epochs = warmup_epochs
            self.T_0 = T_0
            self.T_mult = T_mult
            self.eta_min = eta_min
            self.base_lrs = [group['lr'] for group in optimizer.param_groups]
            self.last_epoch = -1
            self.cosine_scheduler = None
            self.warmup_scheduler = None
        def step(self, epoch=None):
            if epoch is None:
                epoch = self.last_epoch + 1
            self.last_epoch = epoch
            if epoch < self.warmup_epochs:
                if self.warmup_scheduler is None:
                    self.warmup_scheduler = LambdaLR(self.optimizer, 
                        lambda e: float(e) / float(max(1, self.warmup_epochs)), last_epoch=-1)
                self.warmup_scheduler.last_epoch = epoch - 1
                self.warmup_scheduler.step()
            else:
                if self.cosine_scheduler is None:
                    for param_group, base_lr in zip(self.optimizer.param_groups, self.base_lrs):
                        param_group['lr'] = base_lr
                    self.cosine_scheduler = CosineAnnealingWarmRestarts(self.optimizer, 
                        T_0=self.T_0, T_mult=self.T_mult, eta_min=self.eta_min, last_epoch=self.warmup_epochs-1)
                self.cosine_scheduler.last_epoch = epoch - 1
                self.cosine_scheduler.step()
        def state_dict(self):
            return {'last_epoch': self.last_epoch}
        def load_state_dict(self, state):
            self.last_epoch = state['last_epoch']
    return WarmupCosineScheduler(optimizer, warmup_epochs, T_0, T_mult, eta_min)

def train_model(model, train_loader, val_loader, test_loader, num_classes, device, 
                epochs=100, early_stop_patience=20, accumulation_steps=4,
                ce_weight=1.0, focal_weight=0.5):
    criterion = CombinedLoss(ce_weight=ce_weight, focal_weight=focal_weight)
    optimizer = optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-5)
    scheduler = get_warmup_cosine_scheduler(optimizer, warmup_epochs=5, T_0=10, T_mult=2, eta_min=1e-6)
    scaler = GradScaler(enabled=(device.type == 'cuda'))
    
    best_val_loss = float('inf')
    best_val_acc = 0.0
    best_epoch = 0
    no_improve = 0
    best_state = None

    # For plotting
    history = {'train_loss': [], 'train_acc': [], 'val_loss': [], 'val_acc': [], 'lr': []}

    for epoch in range(epochs):
        model.train()
        train_loss = 0.0
        correct_train = 0
        total_train = 0
        optimizer.zero_grad()
        for batch_idx, (data, target) in enumerate(tqdm(train_loader, desc=f"Epoch {epoch+1}/{epochs}")):
            data, target = data.to(device), target.to(device)
            with autocast(enabled=(device.type == 'cuda')):
                loss = criterion(model(data), target) / accumulation_steps
            scaler.scale(loss).backward()
            if (batch_idx + 1) % accumulation_steps == 0:
                scaler.unscale_(optimizer)
                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=0.5)
                scaler.step(optimizer)
                scaler.update()
                optimizer.zero_grad(set_to_none=True)
            train_loss += loss.item() * accumulation_steps
            with torch.no_grad():
                preds = model(data).argmax(dim=1)
                correct_train += (preds == target).sum().item()
                total_train += target.size(0)
        train_acc = correct_train / total_train
        avg_train_loss = train_loss / len(train_loader)

        model.eval()
        val_loss = 0.0
        correct_val = 0
        total_val = 0
        with torch.no_grad():
            for data, target in val_loader:
                data, target = data.to(device), target.to(device)
                with autocast(enabled=(device.type == 'cuda')):
                    val_loss += criterion(model(data), target).item()
                preds = model(data).argmax(dim=1)
                correct_val += (preds == target).sum().item()
                total_val += target.size(0)
        val_loss /= len(val_loader)
        val_acc = correct_val / total_val

        scheduler.step()
        current_lr = optimizer.param_groups[0]['lr']
        history['train_loss'].append(avg_train_loss)
        history['train_acc'].append(train_acc)
        history['val_loss'].append(val_loss)
        history['val_acc'].append(val_acc)
        history['lr'].append(current_lr)

        print(f"Epoch {epoch+1}: Train Loss={avg_train_loss:.4f}, Train Acc={train_acc:.4f}, Val Loss={val_loss:.4f}, Val Acc={val_acc:.4f}, LR={current_lr:.2e}")

        if val_loss < best_val_loss - 1e-4 or val_acc > best_val_acc:
            if val_loss < best_val_loss - 1e-4:
                best_val_loss = val_loss
            if val_acc > best_val_acc:
                best_val_acc = val_acc
            best_epoch = epoch
            no_improve = 0
            best_state = {k: v.cpu().clone() for k, v in model.state_dict().items()}
            torch.save(best_state, 'best_model.pth')
            print(f"  -> New best model saved (Loss={best_val_loss:.4f}, Acc={best_val_acc:.4f})")
        else:
            no_improve += 1
            if no_improve >= early_stop_patience:
                print(f"Early stopping after {epoch+1} epochs")
                break

    if best_state is not None:
        model.load_state_dict(best_state)
    else:
        print("Warning: No best model saved, using current weights.")
    
    # Evaluate on test set with TTA
    #kappa, _, _ = evaluate_model(model, test_loader, device, train_loader.dataset.classes, use_tta=True)
    kappa, _, _, _ = evaluate_model(model, test_loader, device, train_loader.dataset.classes, use_tta=True)
    return model, kappa, best_epoch, history

def evaluate_model(model, test_loader, device, class_names, use_tta=True):
    if use_tta:
        preds, targets, probs = predict_with_tta(model, test_loader, device, n_augs=4)
    else:
        model.eval()
        all_preds, all_targets, all_probs = [], [], []
        with torch.no_grad():
            for data, target in test_loader:
                data = data.to(device)
                out = model(data)
                all_probs.append(F.softmax(out, dim=1).cpu().numpy())
                all_preds.append(torch.argmax(out, dim=1).cpu().numpy())
                all_targets.append(target.numpy())
        preds = np.concatenate(all_preds)
        targets = np.concatenate(all_targets)
        probs = np.concatenate(all_probs, axis=0)
    kappa = cohen_kappa_score(targets, preds)
    print(f"\nCohen's Kappa: {kappa:.4f}\nClassification Report:\n", classification_report(targets, preds, target_names=class_names, digits=4, zero_division=0))
    return kappa, preds, targets, probs


