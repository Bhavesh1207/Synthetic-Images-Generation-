@torch.no_grad()
def predict_with_tta(model, loader, device, n_augs=4):
    model.eval()
    all_probs, all_targets = [], []
    for images, targets in tqdm(loader, desc="TTA"):
        images = images.to(device)
        batch_probs = [
            F.softmax(model(images), dim=1).cpu(), 
            F.softmax(model(torch.flip(images, dims=[3])), dim=1).cpu(), 
            F.softmax(model(torch.flip(images, dims=[2])), dim=1).cpu(), 
            F.softmax(model(torch.flip(images, dims=[2,3])), dim=1).cpu()
        ]
        all_probs.append(torch.stack(batch_probs[:n_augs]).mean(dim=0))
        all_targets.append(targets)
    probs = torch.cat(all_probs, dim=0).numpy()
    targets = torch.cat(all_targets, dim=0).numpy()
    preds = np.argmax(probs, axis=1)
    return preds, targets, probs

def compute_auc(y_true, y_pred_probs, num_classes):
    """Compute macro and micro AUC, and per-class AUC."""
    try:
        # One-hot encode
        y_onehot = np.eye(num_classes)[y_true]
        # Macro AUC (average over classes)
        auc_macro = roc_auc_score(y_onehot, y_pred_probs, average='macro', multi_class='ovr')
        auc_micro = roc_auc_score(y_onehot, y_pred_probs, average='micro', multi_class='ovr')
        # Per-class
        per_class_auc = {}
        for i in range(num_classes):
            try:
                auc_i = roc_auc_score(y_onehot[:, i], y_pred_probs[:, i])
            except ValueError:
                auc_i = float('nan')
            per_class_auc[i] = auc_i
        return auc_macro, auc_micro, per_class_auc
    except Exception as e:
        print(f"AUC computation failed: {e}")
        return None, None, None

def compute_flops_params(model, input_size=(1, 3, 256, 256), device='cuda'):
    """Compute FLOPs and parameters using thop if available, else manual."""
    params = sum(p.numel() for p in model.parameters())
    if THOP_AVAILABLE:
        try:
            dummy = torch.randn(*input_size).to(device)
            flops, _ = profile(model, inputs=(dummy,), verbose=False)
            flops = flops * 2  # thop counts multiply-adds, so we double for FLOPs
            return flops, params
        except:
            pass
    # Fallback: rough estimate
    # We'll just return None for FLOPs
    return None, params

def measure_inference_time(model, loader, device, num_batches=20, use_tta=False):
    """Measure average inference time per batch and per image."""
    model.eval()
    times = []
    with torch.no_grad():
        for i, (images, _) in enumerate(loader):
            if i >= num_batches:
                break
            images = images.to(device)
            start = time.time()
            if use_tta:
                # Simulate TTA: 4 forward passes
                for _ in range(4):
                    _ = model(images)
                    _ = model(torch.flip(images, dims=[3]))
                    _ = model(torch.flip(images, dims=[2]))
                    _ = model(torch.flip(images, dims=[2,3]))
                torch.cuda.synchronize() if device.type == 'cuda' else None
                end = time.time()
                times.append((end - start) / 4)  # average per forward pass (but we did 4*4=16 forwards)
            else:
                _ = model(images)
                torch.cuda.synchronize() if device.type == 'cuda' else None
                end = time.time()
                times.append(end - start)
    avg_batch_time = np.mean(times)
    # batch size may vary; get from loader
    batch_size = loader.batch_size
    avg_per_image = avg_batch_time / batch_size
    return avg_batch_time, avg_per_image

