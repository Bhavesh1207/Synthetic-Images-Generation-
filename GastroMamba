        self.target_layer = target_layer if target_layer is not None else model.cross_fusion

    def _save_fig(self, fig, name): 
        fig.savefig(os.path.join(self.save_dir, name), bbox_inches='tight', dpi=150)
        plt.close(fig)
        
    def normalize_map(self, x): 
        if x.max() == x.min(): return x
        return (x - x.min()) / (x.max() - x.min() + 1e-8)
        
    def overlay_cam(self, img, cam, cmap='jet', alpha=0.5):
        cam_resized = resize(cam, img.shape[:2], preserve_range=True)
        colored = plt.get_cmap(cmap)(cam_resized)[:, :, :3]
        overlay = colored * alpha + img / 255.0
        overlay = np.clip(overlay, 0, 1)
        return (overlay * 255).astype(np.uint8)

    def _format_tensor(self, t, target_hw=None):
        if t.dim() == 3:
            B, L, D = t.shape
            if target_hw is not None:
                H, W = target_hw
            else:
                side = int(np.sqrt(L))
                if side * side != L:
                    raise ValueError(f"Sequence length {L} is not a perfect square.")
                H, W = side, side
            return t.transpose(1, 2).view(B, D, H, W)
        return t

    # --- XAI Methods (similar to previous) ---
    def activation_heatmap(self, img, layer, target_hw=None):
        acts = []
        h = layer.register_forward_hook(lambda m, i, o: acts.append(o.detach().cpu()))
        with torch.no_grad(): 
            self.model(img)
        h.remove()
        a = self._format_tensor(acts[0], target_hw).squeeze(0)
        return self.normalize_map(a.mean(dim=0).numpy())

    def grad_cam(self, img, cls, layer, target_hw=None):
        acts, grads = [], []
        h1 = layer.register_forward_hook(lambda m, i, o: acts.append(o.detach().cpu())) 
        h2 = layer.register_full_backward_hook(lambda m, gi, go: grads.append(go[0].detach().cpu()))
        self.model.zero_grad(set_to_none=True)
        out = self.model(img.clone().requires_grad_(True))
        out[0, cls].backward()
        h1.remove(); h2.remove()
        a = self._format_tensor(acts[0], target_hw).squeeze(0)
        g = self._format_tensor(grads[0], target_hw).squeeze(0)
        weights = torch.mean(g, dim=(1,2), keepdim=True)
        cam = F.relu(torch.sum(weights * a, dim=0)).numpy()
        return self.normalize_map(cam)

    def grad_cam_plus_plus(self, img, cls, layer, target_hw=None):
        acts, grads = [], []
        h1 = layer.register_forward_hook(lambda m, i, o: acts.append(o.detach().cpu()))
        h2 = layer.register_full_backward_hook(lambda m, gi, go: grads.append(go[0].detach().cpu()))
        self.model.zero_grad(set_to_none=True)
        out = self.model(img.clone().requires_grad_(True))
        out[0, cls].backward()
        h1.remove(); h2.remove()
        a = self._format_tensor(acts[0], target_hw).squeeze(0)
        g = self._format_tensor(grads[0], target_hw).squeeze(0)
        alpha = (g**2) / (2*(g**2) + a.sum(dim=(1,2), keepdim=True)*(g**3) + 1e-7)
        weights = (torch.where(torch.isnan(alpha), torch.zeros_like(alpha), alpha) * F.relu(g)).sum(dim=(1,2), keepdim=True)
        cam = F.relu((weights * a).sum(dim=0)).numpy()
        return self.normalize_map(cam)

    def layer_cam(self, img, cls, layer, target_hw=None):
        acts, grads = [], []
        h1 = layer.register_forward_hook(lambda m, i, o: acts.append(o.detach().cpu()))
        h2 = layer.register_full_backward_hook(lambda m, gi, go: grads.append(go[0].detach().cpu()))
        self.model.zero_grad(set_to_none=True)
        out = self.model(img.clone().requires_grad_(True))
        out[0, cls].backward()
        h1.remove(); h2.remove()
        a = self._format_tensor(acts[0], target_hw).squeeze(0)
        g = self._format_tensor(grads[0], target_hw).squeeze(0)
        cam = F.relu((F.relu(g) * a).sum(dim=0)).numpy()
        return self.normalize_map(cam)

    def eigen_cam(self, img, layer, target_hw=None):
        acts = []
        h = layer.register_forward_hook(lambda m, i, o: acts.append(o.detach().cpu()))
        with torch.no_grad(): 
            self.model(img)
        h.remove()
        a = self._format_tensor(acts[0], target_hw).squeeze(0).numpy()
        act_flat = a.reshape(a.shape[0], -1)
        cam = np.linalg.svd(act_flat - act_flat.mean(axis=1, keepdims=True), full_matrices=False)[2][0, :].reshape(a.shape[1], a.shape[2])
        cam = np.abs(cam)
        return self.normalize_map(cam)

    def score_cam(self, img, cls, layer, target_hw=None, bz=2):
        acts = []
        h = layer.register_forward_hook(lambda m, i, o: acts.append(o.detach().cpu()))
        with torch.no_grad(): 
            self.model(img)
        h.remove()
        act = self._format_tensor(acts[0], target_hw).squeeze(0)
        C, H_act, W_act = act.shape[0], act.shape[1], act.shape[2]
        H_img, W_img = img.shape[2], img.shape[3]
        up_act = F.interpolate(act.unsqueeze(0), size=(H_img, W_img), mode='bilinear', align_corners=False)[0]
        max_v = up_act.view(C,-1).max(dim=-1)[0].view(C,1,1)
        min_v = up_act.view(C,-1).min(dim=-1)[0].view(C,1,1)
        norm_acts = ((up_act - min_v) / (max_v - min_v + 1e-7)).to(self.device)
        scores = []
        for i in range(0, C, bz):
            with torch.no_grad():
                scores.append(self.model(img * norm_acts[i:i+bz].unsqueeze(1))[:, cls].detach().cpu())
        weights = F.softmax(torch.cat(scores), dim=0).view(C,1,1)
        cam = F.relu((weights * act).sum(dim=0)).numpy()
        return self.normalize_map(cam)

    def score_cam_plus_plus(self, img, cls, layer, target_hw=None, bz=2):
        acts = []
        h = layer.register_forward_hook(lambda m, i, o: acts.append(o.detach().cpu()))
        with torch.no_grad(): 
            self.model(img)
        h.remove()
        act = self._format_tensor(acts[0], target_hw).squeeze(0)
        C, H_act, W_act = act.shape[0], act.shape[1], act.shape[2]
        H_img, W_img = img.shape[2], img.shape[3]
        up_act = F.interpolate(act.unsqueeze(0), size=(H_img, W_img), mode='bilinear', align_corners=False)[0]
        norm_acts = (up_act - up_act.view(C,-1).min(dim=-1)[0].view(C,1,1)) / (up_act.view(C,-1).max(dim=-1)[0].view(C,1,1) - up_act.view(C,-1).min(dim=-1)[0].view(C,1,1) + 1e-7)
        norm_acts = (norm_acts * norm_acts.view(C, -1).var(dim=1).view(C, 1, 1)).to(self.device)
        scores = []
        for i in range(0, C, bz):
            with torch.no_grad():
                scores.append(self.model(img * norm_acts[i:i+bz].unsqueeze(1))[:, cls].detach().cpu())
        weights = F.softmax(torch.cat(scores), dim=0).view(C,1,1)
        cam = F.relu((weights * act).sum(dim=0)).numpy()
        return self.normalize_map(cam)

    def full_grad_approx(self, img, cls, layer, target_hw=None):
        self.model.zero_grad(set_to_none=True)
        img_clone = img.clone().requires_grad_(True)
        acts, grads = [], []
        h1 = layer.register_forward_hook(lambda m, i, o: acts.append(o.detach().cpu()))
        h2 = layer.register_full_backward_hook(lambda m, gi, go: grads.append(go[0].detach().cpu()))
        out = self.model(img_clone)
        out[0, cls].backward()
        h1.remove(); h2.remove()
        input_relevance = (img_clone.grad[0] * img_clone[0]).sum(dim=0).cpu().detach().numpy()
        a = self._format_tensor(acts[0], target_hw).squeeze(0)
        g = self._format_tensor(grads[0], target_hw).squeeze(0)
        feat_relevance = F.interpolate((g * a).sum(dim=0).unsqueeze(0).unsqueeze(0), size=img.shape[2:], mode='bilinear').squeeze().numpy()
        combined = np.maximum(input_relevance + feat_relevance, 0)
        return self.normalize_map(combined)

    

    def mamba_internals(self, img):
        #def mamba_internals(self, img):
        gates = []
        # FIX: Point to the new shared_mamba attribute directly
        hook = self.model.mamba_encoder.shared_mamba.dynamic_fusion.gating_pathway.register_forward_hook(
            lambda m, i, o: gates.append(o.detach().cpu())
        )
        with torch.no_grad():
            self.model(img)
        hook.remove()
        
        g = gates[0]
        seq_len = g.shape[0]
        H = int(np.sqrt(seq_len))
        W = H
        g = g.view(H, W, 4).numpy()
        tl = self.normalize_map(g[..., 0])
        tr = self.normalize_map(g[..., 1])
        bl = self.normalize_map(g[..., 2])
        br = self.normalize_map(g[..., 3])
        tas = np.argmax(g, axis=-1)
        tsr = self.normalize_map(np.std(g, axis=-1))
        return tl, tr, bl, br, tas, tsr

    def lrp_approx(self, img, cls):
        self.model.zero_grad(set_to_none=True)
        img_clone = img.clone().requires_grad_(True)
        out = self.model(img_clone)
        out[0, cls].backward()
        lrp = torch.sum(img_clone.grad[0] * img_clone[0], dim=0).cpu().detach().numpy()
        lrp = np.maximum(lrp, 0)
        return self.normalize_map(lrp)

    def intermediate_lrp(self, img, cls, layer, target_hw=None):
        acts, grads = [], []
        h1 = layer.register_forward_hook(lambda m, i, o: acts.append(o.detach().cpu()))
        h2 = layer.register_full_backward_hook(lambda m, gi, go: grads.append(go[0].detach().cpu()))
        self.model.zero_grad(set_to_none=True)
        out = self.model(img.clone().requires_grad_(True))
        out[0, cls].backward()
        h1.remove(); h2.remove()
        a = self._format_tensor(acts[0], target_hw).squeeze(0)
        g = self._format_tensor(grads[0], target_hw).squeeze(0)
        lrp = torch.sum(a * g, dim=0).numpy()
        lrp = np.maximum(lrp, 0)
        return self.normalize_map(lrp)

    def generate_lime(self, img):
        if not LIME_AVAILABLE: return None, None
        img_np = img[0].permute(1,2,0).cpu().numpy()
        m, s = np.array([0.485, 0.456, 0.406]), np.array([0.229, 0.224, 0.225])
        def predict(imgs):
            self.model.eval()
            t = [torch.tensor((i - m)/s).permute(2,0,1).float() for i in imgs]
            out_probs = []
            for i in range(0, len(t), 4):
                with torch.no_grad():
                    out_probs.append(F.softmax(self.model(torch.stack(t[i:i+4]).to(self.device)), dim=1).cpu().numpy())
            return np.vstack(out_probs)
        exp = lime_image.LimeImageExplainer().explain_instance(
            np.clip((img_np*s)+m, 0, 1).astype('double'), predict, top_labels=1, hide_color=0, num_samples=300, batch_size=4
        )
        return exp.get_image_and_mask(exp.top_labels[0], positive_only=True, num_features=5, hide_rest=False)

    def generate_shap(self, img, cls):
        if not SHAP_AVAILABLE: return None
        try:
            self.model.eval()
            class SingleClassWrapper(nn.Module):
                def __init__(self, base_model, target_class):
                    super().__init__()
                    self.base_model = base_model
                    self.target_class = target_class
                def forward(self, x):
                    return self.base_model(x)[:, self.target_class].unsqueeze(1)
            target_model = SingleClassWrapper(self.model, cls).to(self.device)
            target_model.eval()
            bg_batch = img.repeat(5, 1, 1, 1) + (torch.randn(5, *img.shape[1:]).to(self.device) * 0.1)
            explainer = shap.GradientExplainer(target_model, bg_batch)
            sv = explainer.shap_values(img)
            if isinstance(sv, list): sv = sv[0] 
            sv_array = np.abs(np.squeeze(sv))
            if sv_array.ndim == 3:
                shap_map = sv_array.sum(axis=0)
            else:
                shap_map = sv_array
            return self.normalize_map(shap_map)
        except Exception as e: 
            print(f"SHAP skip: {e}")
            return None

