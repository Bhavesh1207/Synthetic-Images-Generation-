def plot_training_history(history, save_dir):
    os.makedirs(save_dir, exist_ok=True)  # <--- ensures directory exists
    epochs = range(1, len(history['train_loss']) + 1)
    fig, axs = plt.subplots(1, 2, figsize=(12, 4))
    axs[0].plot(epochs, history['train_loss'], label='Train Loss')
    axs[0].plot(epochs, history['val_loss'], label='Val Loss')
    axs[0].set_xlabel('Epoch')
    axs[0].set_ylabel('Loss')
    axs[0].legend()
    axs[0].grid(True)
    axs[1].plot(epochs, history['train_acc'], label='Train Acc')
    axs[1].plot(epochs, history['val_acc'], label='Val Acc')
    axs[1].set_xlabel('Epoch')
    axs[1].set_ylabel('Accuracy')
    axs[1].legend()
    axs[1].grid(True)
    plt.tight_layout()
    fig.savefig(os.path.join(save_dir, 'training_history.png'), dpi=150)
    plt.close(fig)

def main():
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    print(f"Using device: {device}")

    # Paths
    train_dir = "/kaggle/input/datasets/researchproject12/kvasir-capsule-final-msmd-2/train"
    val_dir = "/kaggle/input/datasets/researchproject12/kvasir-capsule-final-msmd-2/val"
    test_dir = "/kaggle/input/datasets/researchproject12/kvasir-capsule-final-msmd-2/test"

    classes = sorted([d for d in os.listdir(train_dir) if os.path.isdir(os.path.join(train_dir, d))])
    print(f"Detected {len(classes)} classes: {classes}")

    tdict = get_enhanced_transforms(input_size=256)
    num_workers = 4 if os.cpu_count() >= 4 else 0
    train_dl = DataLoader(ImageDataset(train_dir, transform=tdict['train']), batch_size=8, shuffle=True, num_workers=num_workers)
    val_dl = DataLoader(ImageDataset(val_dir, transform=tdict['val']), batch_size=8, shuffle=False, num_workers=num_workers)
    test_ds = ImageDataset(test_dir, transform=tdict['val'])
    test_dl = DataLoader(test_ds, batch_size=8, shuffle=False, num_workers=num_workers)

    # Multi-seed
    seeds = [42]
    kappas = []
    best_histories = []
    seed_best_models = []  # to store (seed, model_state, kappa)

    # Compute model stats (once)
    print("\n=== Model Statistics ===")
    model_temp = MultiScaleDyZEMamba(num_classes=len(classes), embed_dim=256).to(device)
    flops, params = compute_flops_params(model_temp, input_size=(1, 3, 256, 256), device=device)
    print(f"Total Parameters: {params:,}")
    if flops is not None:
        print(f"FLOPs (approx): {flops/1e9:.2f} GFLOPs")
    else:
        print("FLOPs: not computed (install thop)")

    # Also measure inference time (with and without TTA)
    print("\n=== Inference Time (average over 20 batches) ===")
    batch_time, per_img_time = measure_inference_time(model_temp, test_dl, device, num_batches=20, use_tta=False)
    print(f"Without TTA: batch={batch_time:.4f}s, per image={per_img_time:.4f}s")
    batch_time_tta, per_img_time_tta = measure_inference_time(model_temp, test_dl, device, num_batches=20, use_tta=True)
    print(f"With TTA: batch={batch_time_tta:.4f}s, per image={per_img_time_tta:.4f}s (avg over 4 augmentations)")

    # Now run training for each seed
    for seed in seeds:
        print(f"\n========== RUNNING WITH SEED {seed} ==========")
        random.seed(seed)
        np.random.seed(seed)
        torch.manual_seed(seed)
        if torch.cuda.is_available():
            torch.cuda.manual_seed(seed)
            torch.cuda.manual_seed_all(seed)
            torch.backends.cudnn.deterministic = True
            torch.backends.cudnn.benchmark = False

        model = MultiScaleDyZEMamba(num_classes=len(classes), embed_dim=256).to(device)
        model, kappa, best_epoch, history = train_model(
            model, train_dl, val_dl, test_dl, len(classes), device,
            epochs=100, early_stop_patience=20, accumulation_steps=4,
            ce_weight=1.0, focal_weight=0.5
        )
        kappas.append(kappa)
        best_histories.append(history)

        # Save the best model for this seed
        seed_model_path = f'best_model_seed{seed}.pth'
        torch.save(model.state_dict(), seed_model_path)
        seed_best_models.append((seed, model.state_dict(), kappa))

        print(f"Seed {seed} -> Kappa: {kappa:.4f}, best epoch: {best_epoch+1}")

    # Find the best seed (highest kappa)
    best_seed, best_state, best_kappa = max(seed_best_models, key=lambda x: x[2])

    # Average results
    avg_kappa = np.mean(kappas)
    std_kappa = np.std(kappas)
    print(f"\n===== AVERAGE KAPPA OVER {len(seeds)} SEEDS: {avg_kappa:.4f} ± {std_kappa:.4f} =====")
    print(f"===== BEST SEED = {best_seed} with Kappa = {best_kappa:.4f} =====")

    # For final visualizations, we use the best seed's model
    model_final = MultiScaleDyZEMamba(num_classes=len(classes), embed_dim=256).to(device)
    model_final.load_state_dict(best_state)
    print(f"Loaded best model from seed {best_seed} for final evaluation and visualizations.")

    # Evaluate final model thoroughly (including AUC)
    print("\n=== Final Model Evaluation (with TTA) ===")
    kappa_final, preds_final, targets_final, probs_final = evaluate_model(
        model_final, test_dl, device, classes, use_tta=True
    )

    # Compute AUC
    auc_macro, auc_micro, per_class_auc = compute_auc(targets_final, probs_final, len(classes))
    if auc_macro is not None:
        print(f"Macro AUC: {auc_macro:.4f}, Micro AUC: {auc_micro:.4f}")
        print("Per-class AUC:")
        for i, auc_i in per_class_auc.items():
            print(f"  {classes[i]}: {auc_i:.4f}")
    else:
        print("AUC not computed.")

    # Plot training history for the best seed
    # We need to get the history corresponding to the best seed
    best_idx = seeds.index(best_seed)
    plot_training_history(best_histories[best_idx], save_dir='/kaggle/working/visualizations')

    # Run visualizations
    visualizer = ModelVisualizer(model_final, device, classes,
                                 save_dir='/kaggle/working/visualizations',
                                 target_layer=model_final.cross_fusion)
    visualizer.visualize_all(test_dl, test_ds)

    # Save summary metrics
    os.makedirs('/kaggle/working/visualizations', exist_ok=True)
    with open('/kaggle/working/visualizations/metrics_summary.txt', 'w') as f:
        f.write(f"Average Kappa over {len(seeds)} seeds: {avg_kappa:.4f} ± {std_kappa:.4f}\n")
        f.write(f"Best seed: {best_seed} with Kappa: {best_kappa:.4f}\n")
        f.write(f"Final Kappa (TTA) using best seed: {kappa_final:.4f}\n")
        if auc_macro is not None:
            f.write(f"Macro AUC: {auc_macro:.4f}\nMicro AUC: {auc_micro:.4f}\n")
        f.write(f"Parameters: {params:,}\n")
        if flops is not None:
            f.write(f"FLOPs: {flops/1e9:.2f} GFLOPs\n")
        f.write(f"Inference time (no TTA): {per_img_time:.4f}s per image\n")
        f.write(f"Inference time (TTA): {per_img_time_tta:.4f}s per image (avg)\n")

    print("\nAll tasks completed. Check /kaggle/working/visualizations for outputs.")

