# ==============================================================
# 1. DEPTHWISE SEPARABLE CONV & LIGHTWEIGHT DETAIL STREAM
# ==============================================================
class DepthwiseSeparableConv(nn.Module):
    def __init__(self, in_channels, out_channels, stride=1):
        super().__init__()
        self.depthwise = nn.Conv2d(in_channels, in_channels, 3, padding=1, stride=stride, groups=in_channels, bias=False)
        self.bn1 = nn.BatchNorm2d(in_channels)
        self.pointwise = nn.Conv2d(in_channels, out_channels, 1, bias=False)
        self.bn2 = nn.BatchNorm2d(out_channels)
        self.silu = nn.SiLU(inplace=True)

    def forward(self, x):
        return self.silu(self.bn2(self.pointwise(self.silu(self.bn1(self.depthwise(x))))))

class LightweightDetailStream(nn.Module):
    def __init__(self, in_channels=3, out_channels=256):
        super().__init__()
        # 5 Downsampling layers to match EfficientNetV2-S spatial dimensions (usually 1/32 scale)
        self.layer1 = nn.Sequential(nn.Conv2d(in_channels, 32, 3, stride=2, padding=1, bias=False), nn.BatchNorm2d(32), nn.SiLU(inplace=True))
        self.layer2 = DepthwiseSeparableConv(32, 64, stride=2)
        self.layer3 = DepthwiseSeparableConv(64, 128, stride=2)
        self.layer4 = DepthwiseSeparableConv(128, out_channels, stride=2)
        self.layer5 = DepthwiseSeparableConv(out_channels, out_channels, stride=2)

    def forward(self, x): 
        return self.layer5(self.layer4(self.layer3(self.layer2(self.layer1(x)))))

# ==============================================================
# 2. DEEP SEMANTIC STREAM (Standard EfficientNetV2-S)
# ==============================================================
class SemanticStream(nn.Module):
    def __init__(self):
        super().__init__()
        base = models.efficientnet_v2_s(weights=models.EfficientNet_V2_S_Weights.DEFAULT)
        self.features = base.features
        
        # FIX: Removed the 5-channel hack and ghost BatchNorm. Uses standard 3-channel pretrained weights.
        # Freeze early layers; only train the last 3 stages
        for i, stage in enumerate(self.features):
            for param in stage.parameters(): 
                param.requires_grad = (i >= len(self.features) - 3)

    def forward(self, x): 
        return self.features(x)

# ==============================================================
# 3. INFO PRESERVING ALIGNMENT & CROSS PATHWAY FUSION
# ==============================================================
class InformationPreservingAlignment(nn.Module):
    def __init__(self, in_channels=1280, out_channels=256):
        super().__init__()
        self.global_context = nn.Sequential(nn.AdaptiveAvgPool2d(1), nn.Conv2d(in_channels, out_channels, 1, bias=False), nn.Sigmoid())
        self.spatial_compression = nn.Sequential(
            nn.Conv2d(in_channels, out_channels, 1, bias=False), nn.BatchNorm2d(out_channels), nn.SiLU(inplace=True),
            nn.Conv2d(out_channels, out_channels, 3, padding=1, bias=False), nn.BatchNorm2d(out_channels)
        )
        self.final_activation = nn.SiLU(inplace=True)

    def forward(self, x): 
        return self.final_activation(self.spatial_compression(x) * self.global_context(x))

class SelfCrossPathwayFusion(nn.Module):
    def __init__(self, semantic_channels=1280, detail_channels=256, aligned_dim=256):
        super().__init__()
        self.align_semantic = InformationPreservingAlignment(semantic_channels, aligned_dim)
        self.gap = nn.AdaptiveAvgPool2d(1)
        def make_gate(): return nn.Sequential(nn.Linear(aligned_dim, aligned_dim, bias=False), nn.BatchNorm1d(aligned_dim), nn.Sigmoid())
        self.self_weight_sem, self.self_weight_det = make_gate(), make_gate()
        self.cross_weight_sem, self.cross_weight_det = make_gate(), make_gate()

    def forward(self, f_sem, f_det):
        B = f_det.size(0)
        f_sem_aligned = self.align_semantic(f_sem)     
        v_sem, v_det = self.gap(f_sem_aligned).view(B, -1), self.gap(f_det).view(B, -1)            
        w_sem = (self.self_weight_sem(v_sem) + self.cross_weight_sem(v_det)).view(B, -1, 1, 1)
        w_det = (self.self_weight_det(v_det) + self.cross_weight_det(v_sem)).view(B, -1, 1, 1)
        return (f_sem_aligned * w_sem) + (f_det * w_det)

# ==============================================================
# 4. MSMD-ViM: MAMBA ENCODER (FIXED CROSS-SCAN)
# ==============================================================
class Learnable2DPositionalEmbedding(nn.Module):
    def __init__(self, embed_dim, base_size=8):
        super().__init__()
        self.pos_embed = nn.Parameter(torch.zeros(1, embed_dim, base_size, base_size))
        nn.init.trunc_normal_(self.pos_embed, std=0.02)
    def forward(self, x): 
        return x + F.interpolate(self.pos_embed, size=(x.shape[2], x.shape[3]), mode='bicubic', align_corners=False)

class DualPathwayGatedFusion(nn.Module):
    def __init__(self, dim, reduction_ratio=4):
        super().__init__()
        hidden_dim = max(dim // reduction_ratio, 16)
        self.gating_pathway = nn.Sequential(
            nn.Linear(dim * 4, hidden_dim, bias=False), nn.BatchNorm1d(hidden_dim), nn.GELU(),
            nn.Linear(hidden_dim, 4, bias=False), nn.Sigmoid()
        )
        self.feature_pathway = nn.Sequential(nn.Linear(dim, dim, bias=False), nn.SiLU(inplace=True))
        self.output_proj = nn.Linear(dim, dim)
        
    def forward(self, s1, s2, s3, s4):
        w1, w2, w3, w4 = self.gating_pathway(torch.cat([s1, s2, s3, s4], dim=-1).view(-1, s1.shape[-1] * 4)).view(s1.shape[0], s1.shape[1], 4).chunk(4, dim=-1)
        return self.output_proj((self.feature_pathway(s1)*w1) + (self.feature_pathway(s2)*w2) + (self.feature_pathway(s3)*w3) + (self.feature_pathway(s4)*w4))

class CrossScanMambaBlock(nn.Module):
    def __init__(self, d_model, d_state=16, d_conv=4, expand=2):
        super().__init__()
        if REAL_MAMBA:
            self.mamba_tl = Mamba(d_model=d_model, d_state=d_state, d_conv=d_conv, expand=expand)
            self.mamba_br = Mamba(d_model=d_model, d_state=d_state, d_conv=d_conv, expand=expand)
            self.mamba_tr = Mamba(d_model=d_model, d_state=d_state, d_conv=d_conv, expand=expand)
            self.mamba_bl = Mamba(d_model=d_model, d_state=d_state, d_conv=d_conv, expand=expand)
        else:
            def mock_mamba():
                return nn.Sequential(nn.LayerNorm(d_model), nn.Linear(d_model, d_model * 2), nn.GELU(), nn.Linear(d_model * 2, d_model))
            self.mamba_tl, self.mamba_br, self.mamba_tr, self.mamba_bl = mock_mamba(), mock_mamba(), mock_mamba(), mock_mamba()
        
        self.norm = nn.LayerNorm(d_model)
        self.dynamic_fusion = DualPathwayGatedFusion(dim=d_model)

    def forward(self, seq_tl, seq_br, seq_tr, seq_bl, H, W):
        out_tl = self.mamba_tl(seq_tl)
        out_br = self.mamba_br(seq_br)
        out_tr = self.mamba_tr(seq_tr)
        out_bl = self.mamba_bl(seq_bl)

        # FIX: The Un-Flip. We must return the sequences to their original spatial coordinate map 
        # before fusing them, otherwise we destroy spatial integrity.
        B, L, C = out_tl.shape
        def unflip(seq, dims):
            return torch.flip(seq.transpose(1, 2).view(B, C, H, W), dims=dims).flatten(2).transpose(1, 2)

        out_br_unflipped = unflip(out_br, [2, 3])
        out_tr_unflipped = unflip(out_tr, [3])
        out_bl_unflipped = unflip(out_bl, [2])

        return self.norm(self.dynamic_fusion(out_tl, out_br_unflipped, out_tr_unflipped, out_bl_unflipped))

class MultiScaleWindowMambaEncoder(nn.Module):
    def __init__(self, in_channels, embed_dim=256, scales=None):
        super().__init__()
        self.scales = scales if scales else [1, 2, 4]
        
        # 1. Instantiate ONE shared Mamba block
        self.shared_mamba = CrossScanMambaBlock(d_model=embed_dim)
        
        # 2. Instantiate individual patch embeddings for each scale
        self.branches = nn.ModuleList([
            nn.ModuleDict({
                'patch_embed': nn.Conv2d(in_channels, embed_dim, kernel_size=s, stride=s),
                'pos_embed': Learnable2DPositionalEmbedding(embed_dim, base_size=8//s if s<=8 else 1)
            }) for s in self.scales
        ])
        self.scale_weights = nn.Parameter(torch.ones(len(self.scales)))

    def forward(self, x):
        weights = F.softmax(self.scale_weights, dim=0)
        fused_out = 0
        for i, branch in enumerate(self.branches):
            x_patch = branch['pos_embed'](branch['patch_embed'](x))
            B, C, H, W = x_patch.shape
            
            # Prepare sequences for the SHARED mamba block
            seq_tl = x_patch.flatten(2).transpose(1, 2).contiguous()
            seq_br = torch.flip(x_patch, dims=[2, 3]).flatten(2).transpose(1, 2).contiguous()
            seq_tr = torch.flip(x_patch, dims=[3]).flatten(2).transpose(1, 2).contiguous()
            seq_bl = torch.flip(x_patch, dims=[2]).flatten(2).transpose(1, 2).contiguous()

            # Pass through the SHARED block
            out_seq = self.shared_mamba(seq_tl, seq_br, seq_tr, seq_bl, H, W)
            out_2d = out_seq.transpose(1, 2).view(B, C, H, W)
            
            if out_2d.shape[-2:] != x.shape[-2:]:
                out_up = F.interpolate(out_2d, size=(x.shape[2], x.shape[3]), mode='bilinear', align_corners=False)
            else:
                out_up = out_2d
                
            fused_out = fused_out + (out_up * weights[i])
        return fused_out

# ==============================================================
# 5. MAIN MODEL (The "Local First, Global Last" Design)
# ==============================================================
class MultiScaleDyZEMamba(nn.Module):
    def __init__(self, num_classes=27, embed_dim=256):
        super().__init__()
        
        # Parallel CNN Extractors (Local/Mid-Range)
        self.semantic_stream = SemanticStream()                     # Outputs 1280 channels
        self.detail_stream = LightweightDetailStream(in_channels=3) # Outputs 256 channels
        
        # Mid-Network Fusion
        self.cross_fusion = SelfCrossPathwayFusion(semantic_channels=1280, detail_channels=256, aligned_dim=embed_dim)
        
        # Global Brain
        self.mamba_encoder = MultiScaleWindowMambaEncoder(in_channels=embed_dim, embed_dim=embed_dim, scales=[1, 2, 4])
        
        # FIX: Using AdaptiveAvgPool2d to natively pool the 2D tensor returned by Mamba
        self.head = nn.Sequential(
            nn.AdaptiveAvgPool2d(1), 
            nn.Flatten(),
            nn.Linear(embed_dim, 512), 
            nn.BatchNorm1d(512), 
            nn.GELU(), 
            nn.Dropout(0.3), 
            nn.Linear(512, num_classes)
        )

    def forward(self, rgb):
        # 1. Parallel local feature extraction from 3-channel input
        feat_sem = self.semantic_stream(rgb)
        feat_det = self.detail_stream(rgb)
        
        # 2. Fuse semantics and details
        fused_cnn = self.cross_fusion(feat_sem, feat_det)
        
        # 3. Apply global Mamba modeling on the highly compressed feature map
        mamba_features = self.mamba_encoder(fused_cnn) 
        
        # 4. Final Classification
        return self.head(mamba_features)

