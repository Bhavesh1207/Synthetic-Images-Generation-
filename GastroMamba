# 8. LOSS FUNCTIONS
# ==============================================================
class FocalLoss(nn.Module):
    def __init__(self, alpha=1.0, gamma=2.0, reduction='mean'):
        super().__init__()
        self.alpha, self.gamma, self.reduction = alpha, gamma, reduction
    def forward(self, inputs, targets):
        ce_loss = F.cross_entropy(inputs, targets, reduction='none')
        pt = torch.exp(-ce_loss)
        focal_term = (1 - pt) ** self.gamma
        alpha_t = self.alpha if isinstance(self.alpha, (float, int)) else self.alpha[targets]
        loss = alpha_t * focal_term * ce_loss
        return loss.mean() if self.reduction == 'mean' else loss.sum() if self.reduction == 'sum' else loss

class CombinedLoss(nn.Module):
    def __init__(self, ce_weight=1.0, focal_weight=0.5, ce_label_smoothing=0.1, focal_alpha=1.0, focal_gamma=2.0, reduction='mean'):
        super().__init__()
        self.ce_weight, self.focal_weight = ce_weight, focal_weight
        self.ce_loss = nn.CrossEntropyLoss(label_smoothing=ce_label_smoothing, reduction=reduction)
        self.focal_loss = FocalLoss(alpha=focal_alpha, gamma=focal_gamma, reduction=reduction)
    def forward(self, inputs, targets):
        return self.ce_weight * self.ce_loss(inputs, targets) + self.focal_weight * self.focal_loss(inputs, targets)


